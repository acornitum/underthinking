	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"private": true,
	"scripts": {
		"predev": "node --disable-warning=ExperimentalWarning scripts/motions.js build --if-needed",
		"dev": "vite dev",
		"prebuild": "node --disable-warning=ExperimentalWarning scripts/motions.js build --if-needed",
		"build": "vite build",
		"motions:build": "node --disable-warning=ExperimentalWarning scripts/motions.js build",
		"motions:update": "node --disable-warning=ExperimentalWarning scripts/motions.js update",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"type": "module"
}
